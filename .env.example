# Kopier til .env og fyll inn. ALDRI sjekk inn .env i Git.

# Port serveren lytter på
PORT=3001

# production i drift (sikre informasjonskapsler, HSTS, ingen testspillere som standard)
NODE_ENV=development

# PostgreSQL (anbefalt i produksjon). Uten denne brukes minne/fil-lagring.
# DATABASE_URL=postgresql://bruker:passord@localhost:5432/podiepanikk

# Fil-lagring for små installasjoner/lokal utvikling (ignoreres når DATABASE_URL er satt)
# DATA_FILE=./data/podiepanikk.json

# Administrator opprettes/oppdateres ved oppstart. Passord: minst 12 tegn.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Stol på X-Forwarded-*-hoder fra reverse proxy (Fly.io/Render/Nginx). Standard: true i produksjon.
# TRUST_PROXY=true

# Tillat testspillere (bots) i lobbyen. Standard: true i utvikling, false i produksjon.
# ALLOW_BOTS=false

# Kun for automatiske tester/simulator: lar klienten be om raskere klokke.
# ALLOW_TIME_SCALE=false

# Ekstra tillatte opprinnelser (kommaseparert) hvis frontend hostes et annet sted.
# ALLOWED_ORIGINS=https://podiepanikk.example

# Levetid for innlogging i dager
# SESSION_DAYS=30
