{
  "name": "podiepanikk",
  "version": "1.0.0",
  "private": true,
  "description": "PODIEPANIKK! – et 3D-gameshow i nettleseren for 2–12 spillere",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @podiepanikk/server",
    "dev:web": "npm run dev -w @podiepanikk/web",
    "build": "npm run build -w @podiepanikk/web && npm run build -w @podiepanikk/server",
    "start": "npm run start -w @podiepanikk/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/game-engine --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "simulate": "npm run simulate -w @podiepanikk/server",
    "db:generate": "npm run db:generate -w @podiepanikk/server",
    "db:migrate": "npm run db:migrate -w @podiepanikk/server"
  },
  "devDependencies": {
    "concurrently": "9.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
